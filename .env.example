# Copy to .env, generate distinct tokens using README, and chmod 600 .env.
CODEX_CALL_API_TOKEN=replace-owner-token
CODEX_CALL_WORKER_TOKEN=replace-worker-token
CODEX_CALL_MODE=simulate
CODEX_CALL_DATABASE_PATH=data/calls.sqlite3
CODEX_CALL_API_BASE_URL=http://127.0.0.1:8000
CODEX_CALL_MAX_DURATION_S=1800
CODEX_CALL_AGENT_NAME=codex-call

# Required for live API/worker; replace with your own project/trunk.
# CODEX_CALL_LIVEKIT_URL=wss://your-project.livekit.cloud
# CODEX_CALL_LIVEKIT_KEY=your-livekit-key
# CODEX_CALL_LIVEKIT_SECRET=your-livekit-secret
# CODEX_CALL_SIP_TRUNK_ID=your-outbound-trunk-id

# Required in the live worker environment (uv run --env-file .env ...).
# ANTHROPIC_API_KEY=your-anthropic-key
# DEEPGRAM_API_KEY=your-deepgram-key
# ELEVEN_API_KEY=your-elevenlabs-key
CODEX_CALL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CODEX_CALL_DEEPGRAM_MODEL=flux-general-en
CODEX_CALL_ELEVENLABS_MODEL=eleven_turbo_v2_5
# CODEX_CALL_ELEVENLABS_VOICE_ID=your-voice-id

# Events are opt-in. Values for lists are JSON; permit only authorized hosts.
CODEX_CALL_EVENTS_ENABLED=false
CODEX_CALL_EVENT_CALLBACK_HOSTS=[]
CODEX_CALL_MCP_ALLOWED_ORIGINS=[]
